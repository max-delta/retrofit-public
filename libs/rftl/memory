#pragma once
#include "rftl/utility"

#include "rftl/patch/preinclude.inl"
#include RFTL_MEMORY
#include "rftl/patch/postinclude.inl"

// Namespace wrapping
namespace rftl {
// NOTE: Very few wrappings, this is a dangerous file in general, and uses more
//  common programming patterns that aren't a good fit for game development
using std::allocator_traits;
using std::allocator;

// Don't want people using unique_ptr, they should generally be using something
//  like RF::UniquePtr instead, and we want to use a new name to help with that
template<typename T>
using scoped_ptr = std::unique_ptr<T, std::default_delete<T>>;
template<typename T, typename... Types, std::enable_if_t<!std::is_array_v<T>, int> = 0>
[[nodiscard]] scoped_ptr<T> make_scoped( Types&&... args )
{
	return std::make_unique( std::forward<Types>( args )... );
}
template<class T, std::enable_if_t<std::is_array_v<T> && std::extent_v<T> == 0, int> = 0>
[[nodiscard]] scoped_ptr<T> make_scoped( const size_t size )
{
	return std::make_unique<T>( size );
}
}
